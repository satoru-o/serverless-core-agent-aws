# Spec Kit
/.claude
/.specify

# Local .terraform directories
**/.terraform/*

# .tfstate files(バックエンドを使わずローカル運用する場合は特に重要)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# 変数値に機密情報を含む可能性のあるファイル
*.tfvars
*.tfvars.json

# CLI設定ファイル(認証情報を含みうる)
.terraformrc
terraform.rc

# プロバイダのロックファイルに関する例外(後述)
# .terraform.lock.hcl は基本的にコミットする

# 動的プロバイダ設定ファイル
*_override.tf
*_override.tf.json
override.tf
override.tf.json

# terraform plan の出力ファイル(バイナリなのでコミット不要)
*.tfplan